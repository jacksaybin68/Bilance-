APP_VERSION=1
NODE_ENV=development
PORT=3000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=okbong

# SQLite fallback (used when POSTGRES_HOST is unset/localhost). A file keeps
# data across restarts; use `:memory:` for a throwaway database.
SQLITE_PATH=data/okbong.dev.db

# Redis
REDIS_URL=

# JWT
JWT_SECRET=dev-secret-replace-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-replace-in-production
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# Webhook
WEBHOOK_SECRET=webhook-secret-replace-in-production

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Dead letter queue
DEAD_LETTER_QUEUE_ENABLED=true
