{
  "name": "okbong-backend",
  "version": "1.0.0",
  "description": "OKBong backend — NestJS API with WebSocket (Socket.IO), BullMQ queue, Redis adapter.",
  "main": "index.js",
  "scripts": {
    "start": "ts-node-dev -r tsconfig-paths/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "test:e2e": "vitest run --config vitest.config.e2e.ts --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/platform-socket.io": "^12.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^12.0.1",
    "@nestjs/websockets": "^12.0.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^6.3.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
